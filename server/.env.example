# Database
DB_Key=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tastora

# JWT Secrets
JWT_SECRET_KEY_ADMIN=your_admin_jwt_secret
JWT_SECRET_KEY_CUSTOMER=your_customer_jwt_secret
JWT_SECRET_KEY_STAFF=your_staff_jwt_secret
JWT_SECRET_KEY_DELIVERYBOY=your_delivery_boy_jwt_secret

# Razorpay
RPKEYID=your_razorpay_key_id
RPSECRETKEY=your_razorpay_secret_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_API_KEY=your_api_key

# Twilio (SMS Service)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Resend (Email Service)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Tastora <onboarding@resend.dev>
SITE_NAME=Tastora
