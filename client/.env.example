# Render API base URL, without a trailing /api suffix.
NEXT_PUBLIC_BACKEND_SERVER=https://tastora-api.onrender.com

# Public Razorpay key ID only. Never put the key secret in a Vercel variable.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_idNEXT_PUBLIC_BACKEND_SERVER=http://localhost:8000
NEXT_PUBLIC_GEOAPIFY_API_KEY=
